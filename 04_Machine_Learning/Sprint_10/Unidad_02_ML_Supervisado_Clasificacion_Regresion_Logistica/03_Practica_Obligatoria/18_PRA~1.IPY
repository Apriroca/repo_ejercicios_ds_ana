     ]
    }
   ],
   "source": [
    "# Verificar que la estratificación funcionó\n",
    "print(\"Distribución de 'embarked' en TRAIN:\")\n",
    "print(train_set['embarked'].value_counts(normalize=True))\n",
    "print(\"\\nDistribución de 'embarked' en TEST:\")\n",
    "print(test_set['embarked'].value_counts(normalize=True))"
   ]
  },
