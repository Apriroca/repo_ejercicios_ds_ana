   "source": [
    "# Convertir sex a numérico (female=1, male=0)\n",
    "X_train['sex'] = X_train['sex'].map({'female': 1, 'male': 0})\n",
    "\n",
    "# One-Hot Encoding para embarked\n",
    "X_train = pd.get_dummies(X_train, columns=['embarked'], drop_first=True)\n",
    "\n",
    "X_train.head()"
   ]
