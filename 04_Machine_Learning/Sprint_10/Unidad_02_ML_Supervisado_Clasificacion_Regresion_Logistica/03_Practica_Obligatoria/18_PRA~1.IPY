  {
   "cell_type": "code",
   "execution_count": 39,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Registros antes: 891, después: 889\n"
     ]
    }
   ],
   "source": [
    "# Primero eliminamos los 2 registros con embarked nulo para poder estratificar\n",
    "# (son solo 2, no afecta significativamente)\n",
    "df_clean = df.dropna(subset=['embarked']).copy()\n",
    "print(f\"Registros antes: {len(df)}, después: {len(df_clean)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Train: 711 registros\n",
      "Test: 178 registros\n"
     ]
    }
   ],
   "source": [
    "# Split estratificado por embarked\n",
    "train_set, test_set = train_test_split(\n",
    "    df_clean, \n",
    "    test_size=0.2, \n",
    "    stratify=df_clean['embarked'],  # Estratificamos por puerto de embarque\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "print(f\"Train: {len(train_set)} registros\")\n",
    "print(f\"Test: {len(test_set)} registros\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
