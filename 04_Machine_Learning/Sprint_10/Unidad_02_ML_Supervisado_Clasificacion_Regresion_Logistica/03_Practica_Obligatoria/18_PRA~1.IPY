    "cm_df = pd.DataFrame(cm, \n",
    "                     columns=['Pred: No Sobrevive', 'Pred: Sobrevive'],\n",
    "                     index=['Real: No Sobrevive', 'Real: Sobrevive'])\n",
    "\n",
    "print(\"Matriz de Confusión (Test):\")\n",
    "print(cm_df)"
   ]
