   "source": [
    "acc_train = round(accuracy_score(y_train, log_reg.predict(X_train)), 3)\n",
    "acc_test = round(accuracy_score(y_test, log_reg.predict(X_test)), 3)\n",
    "\n",
    "print(\"Accuracy train:\", acc_train)\n",
    "print(\"Accuracy test:\", acc_test)"
   ]
  },
