   "source": [
    "# Importancia de features\n",
    "features_importance = pd.DataFrame({\n",
    "    'feature': X_train.columns,\n",
    "    'coefficient': log_reg.coef_.ravel()\n",
    "})\n",
    "features_importance['abs_coef'] = np.abs(features_importance['coefficient'])\n",
    "features_importance = features_importance.sort_values('abs_coef', ascending=False)\n",
    "\n",
    "print(\"Importancia de Features (por valor absoluto del coeficiente):\")\n",
    "print(features_importance)"
   ]
