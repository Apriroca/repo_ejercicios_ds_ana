   "source": [
    "# 1. Imputar age con la MEDIA DE TRAIN (no de test)\n",
    "X_test['age'].fillna(age_media_train, inplace=True)\n",
    "\n",
    "# 2. Convertir sex a numérico\n",
    "X_test['sex'] = X_test['sex'].map({'female': 1, 'male': 0})\n",
    "\n",
    "# 3. One-Hot Encoding para embarked\n",
    "X_test = pd.get_dummies(X_test, columns=['embarked'], drop_first=True)\n",
    "\n",
    "# 4. Escalar con el SCALER DE TRAIN (no fit de nuevo)\n",
    "X_test[features_to_scale] = scaler.transform(X_test[features_to_scale])\n",
    "\n",
    "# 5. Asegurar que las columnas están en el mismo orden que train\n",
    "X_test = X_test[X_train.columns]\n",
    "\n",
    "X_test.head()"
   ]
  },
